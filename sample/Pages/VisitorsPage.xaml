<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cm="clr-namespace:Plugin.Maui.ContextMenu;assembly=Plugin.Maui.ContextMenu"
    x:Class="Plugin.Maui.ContextMenu.Sample.Pages.VisitorsPage"
    x:Name="this"
    Title="Visitors (Page B)">
    <Grid RowDefinitions="Auto, *" RowSpacing="16" Padding="16">
        <VerticalStackLayout Spacing="8">
            <Label Text="This page has DIFFERENT menu actions: 'Registrar Visita', 'Editar', and 'Remover'." />
            <Label Text="Long-press to verify, then go back to Dashboard." FontAttributes="Italic" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding}" SelectionMode="None">
            <cm:ContextMenu.Menu>
                <DataTemplate>
                    <cm:Menu Title="Visitors Menu">
                        <cm:Action Title="Registrar Visita" />
                        <cm:Action Title="Editar" />
                        <cm:Action Title="Remover" IsDestructive="True" />
                    </cm:Menu>
                </DataTemplate>
            </cm:ContextMenu.Menu>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="4" Padding="16" BackgroundColor="{Binding Color}" CornerRadius="8">
                        <Label Text="{Binding Name}" FontSize="16" TextColor="White" FontAttributes="Bold" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
