<?xml version="1.0" encoding="utf-8"?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cm="clr-namespace:Plugin.Maui.ContextMenu;assembly=Plugin.Maui.ContextMenu"
    x:Class="Plugin.Maui.ContextMenu.Sample.Pages.CrossPageLeakPage"
    x:Name="this"
    Shell.PresentationMode="ModalAnimated"
    Title="Dashboard (Page A)">
    <Grid RowDefinitions="Auto, *" RowSpacing="16" Padding="16">
        <VerticalStackLayout Spacing="8">
            <Label Text="This page has menu actions: 'Ver Invitados' and 'Remover'." />
            <Label
                Text="Tap 'Go to Visitors' then come back. Long-press an item to verify the menu didn't change."
                FontAttributes="Italic" />
            <Button Text="Go to Visitors (Page B)" Clicked="OnGoToVisitors" />
            <Label x:Name="StatusLabel" TextColor="Gray" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding}" SelectionMode="None">
            <cm:ContextMenu.Menu>
                <DataTemplate>
                    <cm:Menu Title="Dashboard Menu">
                        <cm:Action Title="Ver Invitados" />
                        <cm:Action Title="Opcion Oculta" IsVisible="False" />
                        <cm:Action Title="Remover" IsDestructive="True" />
                    </cm:Menu>
                </DataTemplate>
            </cm:ContextMenu.Menu>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="4" Padding="16" BackgroundColor="{Binding Color}"
                        CornerRadius="8">
                        <Label Text="{Binding Name}" FontSize="16" TextColor="White"
                            FontAttributes="Bold" />
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>